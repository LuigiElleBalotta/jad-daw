{
  "$schema-note": "Source of truth for design tokens. Mirrors docs/design-system.md. Colours are #RRGGBB or #RRGGBBAA (CSS order). Qt uses #AARRGGBB, so any generator must reorder the alpha byte.",
  "version": "0.1.0",
  "themes": {
    "dark": {
      "surface": {
        "app": "#0e0e0e",
        "canvas": "#141416",
        "panel": "#1c1c1e",
        "raised": "#2c2c2e",
        "raisedHover": "#3a3a3c",
        "lcd": "#050608",
        "lcdBezel": "#232730"
      },
      "border": {
        "subtle": "#ffffff14",
        "strong": "#ffffff29"
      },
      "text": {
        "primary": "#f2f2f7",
        "secondary": "#a1a1a6",
        "disabled": "#636366",
        "value": "#ffb340"
      },
      "accent": {
        "primary": "#2c7dd9",
        "primaryHover": "#4a93e8"
      },
      "state": {
        "play": "#30d158",
        "record": "#ff453a",
        "solo": "#ffd60a",
        "mute": "#8e8e93",
        "clip": "#ff453a"
      },
      "meter": {
        "low": "#30d158",
        "mid": "#ffd60a",
        "high": "#ff453a"
      },
      "playhead": "#f2f2f7",
      "plugin": {
        "bgTop": "#0d0423",
        "bgBottom": "#1d1635",
        "titleBar": "#262626",
        "header": "#383838"
      },
      "track": {
        "purple":  { "solid": "#8b5cf6", "fill": "#2b205a" },
        "indigo":  { "solid": "#5b6bd6", "fill": "#1f2a5c" },
        "blue":    { "solid": "#3b82f6", "fill": "#134053" },
        "teal":    { "solid": "#14b8a6", "fill": "#0d5353" },
        "green":   { "solid": "#30d158", "fill": "#145a24" },
        "yellow":  { "solid": "#e6c229", "fill": "#6b5a10" },
        "orange":  { "solid": "#ff9f0a", "fill": "#6b3d08" },
        "red":     { "solid": "#ff453a", "fill": "#6b1a16" },
        "pink":    { "solid": "#ff5fa2", "fill": "#6b1f3d" },
        "magenta": { "solid": "#d946ef", "fill": "#5a1a63" }
      }
    }
  },
  "waveform": {
    "strokeOpacity": 0.7
  },
  "font": {
    "family": "Inter",
    "fallback": ["system-ui", "sans-serif"],
    "features": ["tnum"],
    "type": {
      "lcd":     { "size": 22, "weight": 500 },
      "title":   { "size": 15, "weight": 600 },
      "body":    { "size": 13, "weight": 400 },
      "label":   { "size": 11, "weight": 500 },
      "caption": { "size": 10, "weight": 400 }
    }
  },
  "spacing": [2, 4, 6, 8, 12, 16, 24, 32],
  "radius": {
    "control": 6,
    "card": 10,
    "dialog": 14,
    "region": 3,
    "pill": 999
  },
  "size": {
    "control": { "compact": 22, "default": 28, "large": 36 },
    "trackHeight": [40, 56, 80, 120],
    "hitTargetMin": 20,
    "icon": 20,
    "iconStroke": 1.5,
    "knobRing": 2.5,
    "faderTrack": 3,
    "playheadWidth": 1
  },
  "elevation": {
    "popover": { "x": 0, "y": 8, "blur": 24, "color": "#00000066" }
  },
  "motion": {
    "fastMs": 120,
    "panelMs": 200,
    "easing": "ease-out"
  },
  "meter": {
    "peakHoldMs": 1500,
    "segmentGap": 2
  }
}
